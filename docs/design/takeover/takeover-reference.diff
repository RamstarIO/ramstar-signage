+  // ---------- takeover ----------
+  // A slide with "takeover": {"from": "2026-11-11T10:59", "until": "2026-11-11T11:03"}
+  // (local time, like welcome.json) never plays in the rotation. Inside its
+  // window it interrupts whatever is on screen, on every TV, and holds there:
+  // no advancing, no progress bar. When the window ends the playlist resumes
+  // (or welcome mode, if a visit is still on). Checked against the TV's clock
+  // every few seconds, so no fetch is needed at the moment itself.
+
+  const TAKEOVER_CHECK_MS = 5 * 1000;
+
+  function takeoverWindow(slide) {
+    const t = slide && slide.takeover;
+    if (!t || typeof t !== "object") return null;
+    const from = parseLocal(t.from);
+    const until = parseLocal(t.until);
+    if (!from || !until || until <= from) {
+      console.warn(`Takeover "${slide.title || ""}" needs "from" and "until" like 2026-11-11T10:59 - ignored`);
+      return null;
+    }
+    return { from, until };
+  }
+
+  // The first enabled takeover slide whose window includes now, or null.
+  function activeTakeover(now) {
+    const slides = Array.isArray(config.slides) ? config.slides : [];
+    return slides.find((slide) => {
+      if (!slide || slide.enabled === false) return false;
+      const w = takeoverWindow(slide);
+      return w !== null && now >= w.from && now < w.until;
+    }) || null;
+  }
+
+  function applyTakeover() {
+    const now = new Date();
+    const slide = activeTakeover(now);
+    if (slide) {
+      const key = JSON.stringify(slide);
+      if (takeoverOn && key === takeoverShown) return;
+      takeoverOn = true;
+      takeoverShown = key;
+      clearTimeout(timer);
+      timer = null;
+      showTakeover(slide, key, (takeoverWindow(slide).until - now) / 1000);
+    } else if (takeoverOn) {
+      takeoverOn = false;
+      takeoverShown = "";
+      welcomeOn = false;   // let welcome mode re-check itself from scratch
+      welcomeShown = "";
+      applyWelcome();
+      if (welcomeOn) return;
+      position = -1; // back to the first playlist slide
+      if (playlist.length === 0) showStatus("No slides are scheduled right now.");
+      else advance();
+    }
+  }
+
+  async function showTakeover(slide, key, seconds) {
+    let data = null;
+    try {
+      const type = typeOf(slide);
+      if (type === undefined) throw new Error(`Unknown slide type "${slide.type}"`);
+      if (type) data = type.load ? await type.load(slide) : null;
+      else await preload(slide.src);
+    } catch (err) {
+      // Couldn't load it: carry on with the playlist and try again on the next check.
+      console.warn("Takeover slide failed to load:", err.message);
+      if (takeoverShown !== key) return;
+      takeoverOn = false;
+      takeoverShown = "";
+      if (!welcomeOn && timer === null) advance();
+      return;
+    }
+    if (!takeoverOn || takeoverShown !== key) return; // changed while loading
+    // Held, still and without a bar, for the rest of the window.
+    show({ ...slide, progress: false, effect: slide.effect || "none" }, Math.max(1, seconds), data);
+  }
